	column pays_carte = SWITCH(dim_pays[nom_pays], "Côte d'Ivoire", "Ivory Coast", "Guinée-Bissau", "Guinea Bissau", "République centrafricaine", "Central African Republic", "République du Congo", "Republic of Congo", "Guinée équatoriale", "Equatorial Guinea", "Sénégal", "Senegal", "Bénin", "Benin", "Burkina Faso", "Burkina Faso", "Mali", "Mali", "Niger", "Niger", "Togo", "Togo", "Cameroun", "Cameroon", "Gabon", "Gabon", "Tchad", "Chad", 'dim_pays'[nom_pays])
		lineageTag: 1009ab82-d84f-4791-9007-84f94da613d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_pays = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("Z:\Prjojet Convergence UEMOA-CEMAC\05_Dashboard_PowerBI\01_Donnees\modele_powerbi_uemoa_cemac.xlsx"), null, true),
				    dim_pays_Sheet = Source{[Item="dim_pays",Kind="Sheet"]}[Data],
				    #"En-têtes promus" = Table.PromoteHeaders(dim_pays_Sheet, [PromoteAllScalars=true]),
				    #"Type modifié" = Table.TransformColumnTypes(#"En-têtes promus",{{"id_pays", Int64.Type}, {"nom_pays", type text}, {"code_pays", type text}, {"zone", type text}, {"monnaie", type text}})
				in
				    #"Type modifié"

	annotation PBI_ResultType = Table

